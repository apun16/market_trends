# Copy this file to .env.local and add a project API key.
# Never expose this value through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=sk-proj-replace-with-your-project-key
OPENAI_MODEL=gpt-5-nano
# Keep successful Responses available in the OpenAI project logs. Set false for stateless requests.
OPENAI_STORE_RESPONSES=true
OPENAI_REASONING_EFFORT=minimal
OPENAI_TIMEOUT_MS=45000
